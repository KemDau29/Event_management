<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_white_rounded_20">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lý do hủy vé"
        android:textColor="#1A1C1E"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:gravity="center"/>

    <RadioGroup
        android:id="@+id/rgCancelReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rbReason1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tôi bận việc đột xuất"
            android:textSize="14sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbReason2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đặt nhầm sự kiện/vé"
            android:textSize="14sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbReason3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không muốn tham gia nữa"
            android:textSize="14sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbReasonOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lý do khác..."
            android:textSize="14sp"
            android:padding="8dp"/>
    </RadioGroup>

    <EditText
        android:id="@+id/edtOtherReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập lý do của bạn"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_gray_rounded_10"
        android:padding="12dp"
        android:minHeight="80dp"
        android:gravity="top"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelDialog"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#ffffff"
            android:text="ĐÓNG" />

        <Button
            android:id="@+id/btnConfirmCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XÁC NHẬN HỦY"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
