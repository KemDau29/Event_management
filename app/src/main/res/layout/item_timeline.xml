<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/viewLineTop"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:background="#DDDDDD" />

        <View
            android:id="@+id/viewTimelineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/circle_gray"
            android:backgroundTint="#185FA5" />

        <View
            android:id="@+id/viewLineBottom"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:minHeight="40dp"
            android:background="#DDDDDD" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvTimelineTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00 - 08:30"
            android:textStyle="bold"
            android:textColor="#185FA5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTimelineActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đón khách và làm thủ tục check-in"
            android:textColor="#333333"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
