<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin sự kiện"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAdminEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên sự kiện"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAdminEventDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mô tả sự kiện"
                android:gravity="top"
                android:minLines="3"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAdminEventLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Địa điểm (Địa chỉ)"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdminEventLat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vĩ độ (Latitude)"
                    android:inputType="numberDecimal|numberSigned"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdminEventLng"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kinh độ (Longitude)"
                    android:inputType="numberDecimal|numberSigned"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchIsLimited"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giới hạn số lượng vé"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdminEventPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Giá vé (đ)"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutAdminEventRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdminEventRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Số lượng vé"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Phần Early Bird -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vé sớm (Early Bird)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#185FA5"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdminEarlyBirdPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Giá vé sớm (đ)"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdminEarlyBirdLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Số lượng vé sớm"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tvAdminEarlyBirdOpen"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:text="Ngày mở bán sớm"
                android:gravity="center_vertical"
                android:textColor="#0F172A"
                android:background="@drawable/card_background"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="4dp"
                android:drawableEnd="@android:drawable/ic_menu_today"/>
            <TextView
                android:id="@+id/tvAdminEarlyBirdDeadline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:text="Ngày kết thúc bán sớm"
                android:gravity="center_vertical"
                android:textColor="#0F172A"
                android:background="@drawable/card_background"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="4dp"
                android:drawableEnd="@android:drawable/ic_menu_today"/>
        </LinearLayout>
        <!-- Hết phần Early Bird -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAdminEventImageUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Link ảnh (URL)"
                android:inputType="textUri"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày diễn ra"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/tvAdminEventDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Chọn ngày và giờ"
            android:gravity="center_vertical"
            android:textColor="#000000"
            android:background="@drawable/bg_gray_rounded_10"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:drawableEnd="@android:drawable/ic_menu_myplaces"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giai đoạn đăng ký (Mở - Đóng)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tvAdminTicketOpen"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:text="Ngày mở"
                android:gravity="center_vertical"
                android:textColor="#0F172A"
                android:background="@drawable/card_background"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/tvAdminTicketClose"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:text="Ngày đóng"
                android:gravity="center_vertical"
                android:textColor="#0F172A"
                android:background="@drawable/card_background"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Danh mục"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spinnerAdminEventCategory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_gray_rounded_10"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminDialogCancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="#666666"
                android:backgroundTint="#F5F5F5"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminDialogSave"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="Lưu lại"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#185FA5"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>