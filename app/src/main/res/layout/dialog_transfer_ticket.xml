<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Chuyển vé"
                android:textColor="#1A1C1E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#888888"
                android:contentDescription="Close" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vui lòng nhập chính xác username của người bạn muốn chuyển vé."
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username người nhận"
            android:textColor="#1A1C1E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edtRecipientUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/card_background"
            android:backgroundTint="#F1F3F6"
            android:hint="Nhập username..."
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số lượng vé muốn chuyển"
            android:textColor="#1A1C1E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnMinusTransfer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:backgroundTint="#F1F3F6"
                android:textColor="#1A1C1E"
                android:padding="0dp"
                app:cornerRadius="8dp"/>

            <TextView
                android:id="@+id/tvTransferQuantity"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#185FA5"/>

            <Button
                android:id="@+id/btnPlusTransfer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:backgroundTint="#F1F3F6"
                android:textColor="#1A1C1E"
                android:padding="0dp"
                app:cornerRadius="8dp"/>

            <TextView
                android:id="@+id/tvMaxQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ Tối đa: 01"
                android:layout_marginStart="12dp"
                android:textColor="#888888"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelTransfer"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Hủy"
                android:backgroundTint="#F1F3F6"
                android:textColor="#757575"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btnConfirmTransfer"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Xác nhận"
                android:backgroundTint="#185FA5"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
