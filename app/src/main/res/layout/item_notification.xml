<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvNotificationItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiêu đề thông báo"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1A1C1E" />

    <TextView
        android:id="@+id/tvNotificationItemMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thông báo nội dung ngắn"
        android:textSize="14sp"
        android:textColor="#616161"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvNotificationItemTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="12/06/2026 14:20"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:layout_marginTop="8dp" />
</LinearLayout>
