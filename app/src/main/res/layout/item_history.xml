<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:elevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvHistoryOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã đơn: #12345"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20/05/2026"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="12dp"/>

    <!-- Danh sách các sự kiện trong đơn hàng này -->
    <LinearLayout
        android:id="@+id/layoutHistoryItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng tiền:"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvHistoryTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200.000đ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#185FA5"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

</LinearLayout>
