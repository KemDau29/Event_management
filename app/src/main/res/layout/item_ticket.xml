<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Đã mua"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/card_background"
                android:backgroundTint="#E8F5E9"/>

            <TextView
                android:id="@+id/tvTicketCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="#IL611G5Z"
                android:textColor="#888888"
                android:textSize="12sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvTicketTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên sự kiện"
            android:textColor="#1A1C1E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian sự kiện:"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="01/06/2026 • 08:00"
                android:textColor="#185FA5"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày mua:"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPurchaseDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="25/05/2026 14:47"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số lượng:"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTicketQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="01"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng tiền:"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTicketTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="120.000 đ"
                android:textColor="#185FA5"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvRecipientInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#F57C00"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            android:text="Người nhận: username"/>

        <TextView
            android:id="@+id/tvCancelReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#B71C1C"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            android:text="Lý do hủy: ..."/>

        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTransferTicket"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#4CAF50"
                android:text="CHUYỂN VÉ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btnCancelTicket"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#B71C1C"
                android:text="HỦY VÉ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOngoingNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sự kiện đang diễn ra. Bấm để xem lịch trình."
            android:textColor="#185FA5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#F0F7FF"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
